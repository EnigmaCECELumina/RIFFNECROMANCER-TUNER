# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# All secrets must come from the environment — the app refuses to start with
# insecure fallbacks.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=riffnecromancer

# --- Auth ---
# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- CORS ---
# Comma-separated allow-list of origins. Must NOT contain "*" (credentials are enabled).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend URL ---
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (for direct OAuth implementation) ---
GOOGLE_CLIENT_ID=368876449791-echg9kglvdpj7nki9ge1t5h9lhued0q4.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Demo seeding (optional, staging only) ---
# Leave SEED_DEMO_USERS unset in production. When enabled, demo accounts are
# created using the passwords below.
SEED_DEMO_USERS=
DEMO_PREMIUM_PASSWORD=
DEMO_FREE_PASSWORD=
